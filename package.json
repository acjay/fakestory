{
  "name": "fakestory-reading-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:story": "VITE_LOCAL_STORY=1 vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/check-build.ts",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "import:notion": "node scripts/import-notion.ts"
  },
  "dependencies": {
    "katex": "^0.16.22",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "prettier": "^3.10.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.3"
  },
  "engines": {
    "node": ">=22.18"
  }
}
