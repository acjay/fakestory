// Cloudflare Workers configuration: the site is a static-assets-only Worker.
// Workers Builds (connected to GitHub) runs `npm run build` and deploys:
// `main` to production, and every other branch to its own preview URL.
// See docs/hosting.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fakestory",
  "compatibility_date": "2026-11-01",

  // No server code: Cloudflare serves the built files from dist/.
  "assets": {
    "directory": "./dist",

    // /demos/harmonic-tone and /demos/harmonic-tone/ both serve its index.html.
    "html_handling": "auto-trailing-slash",

    // Unknown paths get a plain 404, not the reading page.
    "not_found_handling": "none",
  },

  // Production at fakestory.<account>.workers.dev; previews get their own URLs.
  "workers_dev": true,
  "preview_urls": true,
}
